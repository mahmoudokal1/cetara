{% comment %} Dusk & Dawn — Orbit Carousel Section V6 {% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════
   ROOT
═══════════════════════════════════ */
#dd-orbit-v6 {
  --main:   #12BFB4;
  --accent: #E11F78;
  --shadow: rgba(18,191,180,.30);

  width: 100vw;
  margin-left: calc(50% - 50vw);
  padding: 0 0 52px;
  position: relative;
  overflow: hidden;
  font-family: Inter, sans-serif;
  background: #ffffff;
}

#dd-orbit-v6 * { box-sizing: border-box; }

/* ═══════════════════════════════════
   SPLIT BACKGROUND BLOBS
   Left blob = accent/pink, Right blob = main/teal
   — each product swaps these colors
═══════════════════════════════════ */
.ddos6-bg-l,
.ddos6-bg-r {
  position: absolute;
  width: 62%;
  height: 72%;
  top: 0;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  transition: background 0.85s ease;
  will-change: background;
}

.ddos6-bg-l {
  left: -12%;
  background: radial-gradient(ellipse at 65% 45%,
    var(--blob-l, rgba(225,31,120,.24)) 0%,
    transparent 65%);
}

.ddos6-bg-r {
  right: -12%;
  background: radial-gradient(ellipse at 35% 45%,
    var(--blob-r, rgba(18,191,180,.24)) 0%,
    transparent 65%);
}

/* ═══════════════════════════════════
   HEADER
═══════════════════════════════════ */
.ddos6-head {
  position: relative;
  z-index: 5;
  text-align: center;
  padding: 54px 20px 16px;
}

.ddos6-kicker {
  font-size: 11px;
  letter-spacing: 6px;
  text-transform: uppercase;
  font-weight: 800;
  color: var(--accent);
  margin-bottom: 10px;
  transition: color .5s ease;
}

.ddos6-title {
  margin: 0;
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(40px, 7vw, 68px);
  line-height: 0.93;
  color: #15203B;
}

.ddos6-title span {
  color: var(--main);
  transition: color .5s ease;
}

/* ═══════════════════════════════════
   NAVIGATION DOTS
═══════════════════════════════════ */
.ddos6-dots {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 22px;
}

.ddos6-dot {
  width: 10px;
  height: 10px;
  border-radius: 99px;
  background: rgba(21,32,59,.15);
  border: 0;
  padding: 0;
  cursor: pointer;
  transition: width .32s ease, background .32s ease;
}

.ddos6-dot.active {
  width: 28px;
  background: var(--main);
}

/* ═══════════════════════════════════
   PRODUCT STAGE
═══════════════════════════════════ */
.ddos6-stage {
  position: relative;
  z-index: 4;
  height: 460px;
  width: 100%;
  overflow: hidden;
  touch-action: pan-y;
  user-select: none;
  cursor: grab;
}

.ddos6-stage:active { cursor: grabbing; }

/* Orbit dashed ellipse track */
.ddos6-orbit-track {
  position: absolute;
  left: 50%;
  bottom: 44px;
  width: 78%;
  height: 72px;
  transform: translateX(-50%);
  border: 1.5px dashed rgba(21,32,59,.09);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}

/* Glow shadow under active product */
.ddos6-floor {
  position: absolute;
  left: 50%;
  bottom: 32px;
  width: 160px;
  height: 28px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse,
    var(--shadow) 0%,
    transparent 70%);
  filter: blur(10px);
  pointer-events: none;
  z-index: 2;
  transition: background .7s ease;
}

/* ═══════════════════════════════════
   PRODUCT SLOTS
   JS moves these along the orbit ellipse.
   They start at left:50%, top:48% (center)
   and are offset via transform.
═══════════════════════════════════ */
.ddos6-slot {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 230px;
  height: 370px;
  margin-left: -115px;
  margin-top: -185px;
  display: flex;
  align-items: center;
  justify-content: center;
  will-change: transform, opacity;
  transition:
    transform .80s cubic-bezier(.22,1,.36,1),
    opacity   .60s ease;
}

/* During drag: no transition for instant feel */
.ddos6-slot.instant {
  transition: none !important;
}

/* Snap-back after aborted drag */
.ddos6-slot.snap {
  transition:
    transform .48s cubic-bezier(.22,1,.36,1),
    opacity   .38s ease;
}

/* Product image */
.ddos6-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  user-select: none;
  filter: drop-shadow(0 28px 24px rgba(0,0,0,.14));
  display: block;
}

/* ═══════════════════════════════════
   WOBBLE — active product floats
═══════════════════════════════════ */
@keyframes ddos6Float {
  0%   { transform: translateY(0px)  rotate(-0.45deg); }
  27%  { transform: translateY(-9px) rotate( 0.45deg); }
  56%  { transform: translateY(-5px) rotate(-0.2deg);  }
  100% { transform: translateY(0px)  rotate(-0.45deg); }
}

.ddos6-img.floating {
  animation: ddos6Float 3.6s ease-in-out infinite;
}

/* ═══════════════════════════════════
   ARROW BUTTONS
═══════════════════════════════════ */
.ddos6-arrow {
  position: absolute;
  top: 48%;
  width: 48px;
  height: 48px;
  transform: translateY(-50%);
  border-radius: 50%;
  border: 0;
  background: rgba(255,255,255,.93);
  color: var(--main);
  font-size: 26px;
  line-height: 1;
  z-index: 10;
  cursor: pointer;
  box-shadow: 0 6px 22px rgba(21,32,59,.10);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow .2s ease, transform .2s ease, color .4s ease;
}

.ddos6-arrow:hover {
  box-shadow: 0 10px 30px rgba(21,32,59,.17);
  transform: translateY(-50%) scale(1.06);
}

.ddos6-prev { left: 14px; }
.ddos6-next { right: 14px; }

/* ═══════════════════════════════════
   INFO CARD
═══════════════════════════════════ */
.ddos6-card {
  position: relative;
  z-index: 10;
  width: min(490px, calc(100% - 30px));
  margin: 6px auto 0;
  border-radius: 32px;
  padding: 28px 28px 32px;
  background: rgba(255,255,255,.93);
  border: 1px solid rgba(255,255,255,.95);
  box-shadow:
    0 20px 52px rgba(21,32,59,.09),
    0  2px  8px rgba(21,32,59,.04);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.ddos6-card.anim {
  animation: ddos6CardIn .42s cubic-bezier(.22,1,.36,1) both;
}

@keyframes ddos6CardIn {
  from { opacity: .3; transform: translateY(16px); }
  to   { opacity: 1;  transform: translateY(0);    }
}

/* Step badge */
.ddos6-step {
  display: inline-flex;
  padding: 7px 16px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .05em;
  margin-bottom: 14px;
  transition: background .45s ease, color .45s ease;
}

/* Product name */
.ddos6-name {
  margin: 0;
  font-family: 'Cormorant Garamond', serif;
  font-size: 46px;
  line-height: .93;
  color: #15203B;
}

.ddos6-name span {
  transition: color .45s ease;
}

/* Description */
.ddos6-desc {
  margin: 14px 0 0;
  font-size: 17px;
  line-height: 1.5;
  color: #273044;
}

/* Feature chips */
.ddos6-chips {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
  margin-top: 18px;
}

.ddos6-chip {
  padding: 9px 14px;
  border-radius: 999px;
  background: rgba(255,255,255,.82);
  border: 1px solid rgba(21,32,59,.09);
  font-size: 13px;
  font-weight: 700;
  color: #15203B;
}

.ddos6-chip em {
  font-style: normal;
  margin-right: 5px;
  color: var(--main);
  transition: color .45s ease;
}

/* Price + ATC row */
.ddos6-buy {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 22px;
}

.ddos6-price {
  font-family: 'Cormorant Garamond', serif;
  font-size: 52px;
  line-height: 1;
  color: var(--main);
  white-space: nowrap;
  flex-shrink: 0;
  transition: color .45s ease;
}

.ddos6-atc {
  flex: 1;
  height: 58px;
  border: 0;
  border-radius: 999px;
  background: var(--main);
  color: #fff;
  font-size: 17px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 14px 32px var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition:
    transform .22s ease,
    box-shadow .22s ease,
    background .45s ease;
}

.ddos6-atc:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 40px var(--shadow);
}

.ddos6-atc:disabled {
  opacity: .65;
  cursor: default;
  transform: none;
}

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
@media (max-width: 600px) {
  .ddos6-head   { padding: 38px 16px 14px; }
  .ddos6-kicker { font-size: 10px; letter-spacing: 5px; }
  .ddos6-title  { font-size: 40px; }
  .ddos6-dots   { margin-top: 18px; }

  .ddos6-stage  { height: 390px; }
  .ddos6-slot   {
    width: 195px; height: 310px;
    margin-left: -97px; margin-top: -155px;
  }

  .ddos6-card   {
    width: calc(100% - 22px);
    padding: 22px 20px 26px;
    border-radius: 28px;
  }
  .ddos6-name   { font-size: 38px; }
  .ddos6-desc   { font-size: 16px; }
  .ddos6-price  { font-size: 44px; }
  .ddos6-atc    { height: 54px; font-size: 16px; }
}

@media (max-width: 380px) {
  .ddos6-stage  { height: 350px; }
  .ddos6-slot   {
    width: 175px; height: 280px;
    margin-left: -87px; margin-top: -140px;
  }
  .ddos6-name   { font-size: 34px; }
  .ddos6-price  { font-size: 40px; }
}
</style>

<!-- ═══════════════ HTML ═══════════════ -->
<section id="dd-orbit-v6">

  <div class="ddos6-bg-l"></div>
  <div class="ddos6-bg-r"></div>

  <div class="ddos6-head">
    <div class="ddos6-kicker">From Root To Tip</div>
    <h2 class="ddos6-title">Shop Your <span>Curl Routine</span></h2>
    <div class="ddos6-dots" id="ddos6Dots"></div>
  </div>

  <div class="ddos6-stage" id="ddos6Stage">
    <div class="ddos6-orbit-track"></div>
    <div class="ddos6-floor"  id="ddos6Floor"></div>

    <div class="ddos6-slot" id="ddos6Slot0">
      <img class="ddos6-img" id="ddos6Img0" alt="">
    </div>
    <div class="ddos6-slot" id="ddos6Slot1">
      <img class="ddos6-img" id="ddos6Img1" alt="">
    </div>
    <div class="ddos6-slot" id="ddos6Slot2">
      <img class="ddos6-img" id="ddos6Img2" alt="">
    </div>

    <button class="ddos6-arrow ddos6-prev" type="button">&#8249;</button>
    <button class="ddos6-arrow ddos6-next" type="button">&#8250;</button>
  </div>

  <div class="ddos6-card" id="ddos6Card">
    <div class="ddos6-step"  id="ddos6Step"></div>
    <h3 class="ddos6-name"  id="ddos6Name"></h3>
    <p  class="ddos6-desc"  id="ddos6Desc"></p>
    <div class="ddos6-chips" id="ddos6Chips"></div>
    <div class="ddos6-buy">
      <div class="ddos6-price" id="ddos6Price">—</div>
      <button class="ddos6-atc" id="ddos6Atc" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        Add to Cart
      </button>
    </div>
  </div>

</section>

<!-- ═══════════════ SCRIPT ═══════════════ -->
<script>
(function () {
  'use strict';

  /* ──────────────────────────────────────────
     PRODUCT DATA
     Populate image / price / variantId at runtime
     from the Shopify product API.
  ────────────────────────────────────────── */
  const PRODUCTS = [
    {
      handle: 'leave-in-conditioner-curly-250ml',
      url:    '/products/leave-in-conditioner-curly-250ml',
      step:   'Step 1 • Condition',
      title:  'Leave In Conditioner',
      sub:    'Curly',
      desc:   'Hydrates, detangles, and defines curls while reducing frizz.',
      chips:  ['Hydration', 'Frizz Control', 'Natural Shine'],
      /* theme */
      main:   '#E11F78',
      blobL:  'rgba(225,31,120,.30)',
      blobR:  'rgba(255,155,190,.20)',
      shadow: 'rgba(225,31,120,.28)',
      stepBg: 'rgba(225,31,120,.12)',
    },
    {
      handle: 'curly-hair-gel',
      url:    '/products/curly-hair-gel',
      step:   'Step 2 • Style',
      title:  'Hair Styling Gel',
      sub:    'Curly',
      desc:   'Lightweight hold that keeps curls defined, shiny, and touchable.',
      chips:  ['Long Hold', 'No Crunch', 'Natural Shine'],
      main:   '#12BFB4',
      blobL:  'rgba(225,31,120,.22)',
      blobR:  'rgba(18,191,180,.24)',
      shadow: 'rgba(18,191,180,.28)',
      stepBg: 'rgba(18,191,180,.12)',
    },
    {
      handle: 'curl-defining-brush',
      url:    '/products/curl-defining-brush',
      step:   'Step 3 • Define',
      title:  'Curl Defining Brush',
      sub:    'Styling',
      desc:   'Detangle, shape, and separate curls with better control.',
      chips:  ['Detangle', 'Curl Shape', 'Less Breakage'],
      main:   '#9B6AD6',
      blobL:  'rgba(155,106,214,.28)',
      blobR:  'rgba(91,191,192,.22)',
      shadow: 'rgba(155,106,214,.28)',
      stepBg: 'rgba(155,106,214,.12)',
    },
  ];

  const N = PRODUCTS.length;
  const wrap = (i) => ((i % N) + N) % N;

  /* ──────────────────────────────────────────
     DOM
  ────────────────────────────────────────── */
  const root   = document.getElementById('dd-orbit-v6');
  const blobL  = root.querySelector('.ddos6-bg-l');
  const blobR  = root.querySelector('.ddos6-bg-r');
  const stage  = document.getElementById('ddos6Stage');
  const floor  = document.getElementById('ddos6Floor');
  const slots  = [
    document.getElementById('ddos6Slot0'),
    document.getElementById('ddos6Slot1'),
    document.getElementById('ddos6Slot2'),
  ];
  const imgs    = slots.map((s) => s.querySelector('img'));
  const dotsEl  = document.getElementById('ddos6Dots');
  const card    = document.getElementById('ddos6Card');
  const stepEl  = document.getElementById('ddos6Step');
  const nameEl  = document.getElementById('ddos6Name');
  const descEl  = document.getElementById('ddos6Desc');
  const chipsEl = document.getElementById('ddos6Chips');
  const priceEl = document.getElementById('ddos6Price');
  const atcEl   = document.getElementById('ddos6Atc');

  /* ──────────────────────────────────────────
     ORBIT MATHS
     Orbit is an ellipse viewed from slightly above.
       angle = 0°   → front/center (largest, most opaque)
       angle = ±SA° → sides (smaller, more transparent)
  ────────────────────────────────────────── */
  const SA         = 56;    // side-slot angle in degrees
  const ORB_RY     = 42;    // vertical depth (px)
  const SCALE_MIN  = 0.68;
  const SCALE_MAX  = 1.20;
  const OPA_MIN    = 0.40;

  /* Dynamic horizontal radius — fills ~85% of stage width per side */
  function orbRX() {
    return Math.min(stage.clientWidth * 0.40, 255);
  }

  /**
   * CSS transform values for a product sitting at `deg` on the orbit.
   */
  function orbitPos(deg) {
    const a    = deg * (Math.PI / 180);
    const cosA = Math.cos(a);
    const sinA = Math.sin(a);
    return {
      x:       orbRX() * sinA,
      y:       ORB_RY  * (1 - cosA),
      scale:   SCALE_MIN + (SCALE_MAX - SCALE_MIN) * Math.max(0, cosA),
      opacity: OPA_MIN   + (1 - OPA_MIN)           * Math.max(0, cosA),
      z:       Math.round(3 + 7 * cosA),
    };
  }

  /* ──────────────────────────────────────────
     STATE
  ────────────────────────────────────────── */
  let active   = 1;     // center product index
  let busy     = false;
  let orbAngle = 0;     // live rotation offset while dragging

  /* ──────────────────────────────────────────
     SLOT POSITIONING
     BASE_ANGLES = [left-slot, center-slot, right-slot]
  ────────────────────────────────────────── */
  const BASE = [-SA, 0, SA];

  function applyPos(angleOffset, instant) {
    slots.forEach((slot, i) => {
      const p = orbitPos(BASE[i] + angleOffset);
      slot.classList.toggle('instant', instant);
      slot.style.transform = `translate(${p.x.toFixed(2)}px,${p.y.toFixed(2)}px) scale(${p.scale.toFixed(4)})`;
      slot.style.opacity   = p.opacity.toFixed(4);
      slot.style.zIndex    = p.z;
    });
  }

  /* ──────────────────────────────────────────
     IMAGE ASSIGNMENT + WOBBLE
  ────────────────────────────────────────── */
  function assignImages() {
    [wrap(active - 1), active, wrap(active + 1)].forEach((pi, si) => {
      const p    = PRODUCTS[pi];
      imgs[si].src = p.image || '';
      imgs[si].alt = p.title;
      imgs[si].classList.toggle('floating', si === 1);
    });
  }

  /* ──────────────────────────────────────────
     THEME — background blobs + CSS vars
  ────────────────────────────────────────── */
  function applyTheme(p) {
    root.style.setProperty('--main',   p.main);
    root.style.setProperty('--shadow', p.shadow);
    blobL.style.background =
      `radial-gradient(ellipse at 65% 45%, ${p.blobL} 0%, transparent 65%)`;
    blobR.style.background =
      `radial-gradient(ellipse at 35% 45%, ${p.blobR} 0%, transparent 65%)`;
    floor.style.background =
      `radial-gradient(ellipse, ${p.shadow} 0%, transparent 70%)`;
    stepEl.style.background = p.stepBg;
    stepEl.style.color      = p.main;
  }

  /* ──────────────────────────────────────────
     CARD UPDATE
  ────────────────────────────────────────── */
  function updateCard(animate) {
    const p = PRODUCTS[active];
    applyTheme(p);

    if (animate) {
      card.classList.remove('anim');
      void card.offsetWidth;
      card.classList.add('anim');
    }

    stepEl.textContent  = p.step;
    nameEl.innerHTML    = `${p.title} <span style="color:${p.main}">${p.sub}</span>`;
    descEl.textContent  = p.desc;
    priceEl.textContent = p.price ? `LE ${Math.round(p.price / 100)}` : '';
    chipsEl.innerHTML   = p.chips
      .map((c) => `<div class="ddos6-chip"><em>✓</em>${c}</div>`)
      .join('');

    buildDots();
  }

  /* ──────────────────────────────────────────
     DOTS
  ────────────────────────────────────────── */
  function buildDots() {
    dotsEl.innerHTML = PRODUCTS
      .map((_, i) => `<button class="ddos6-dot${i === active ? ' active' : ''}" data-i="${i}" type="button"></button>`)
      .join('');
    dotsEl.querySelectorAll('.ddos6-dot').forEach((d) => {
      d.addEventListener('click', () => {
        const t = +d.dataset.i;
        if (t === active || busy) return;
        const fwd = wrap(t - active);
        const dir = fwd <= N / 2 ? 1 : -1;
        goTo(t, dir * SA);
      });
    });
  }

  /* ──────────────────────────────────────────
     NAVIGATION
     incomingAngle: the orbit offset at which we
     "teleport" before playing the CSS transition.
     For button clicks = ±SA (full swing).
     For confirmed drags = ±SA + dragOffset
     (so the transition continues from where the
     user's finger left off).
  ────────────────────────────────────────── */
  function goTo(newIdx, incomingAngle) {
    if (busy || wrap(newIdx) === active) return;
    busy   = true;
    active = wrap(newIdx);
    orbAngle = 0;

    assignImages();

    /* Teleport all slots to the "incoming" angle instantly */
    applyPos(incomingAngle, true);
    void slots[1].offsetWidth; /* force reflow */

    /* Now play the smooth transition to 0° */
    applyPos(0, false);
    updateCard(true);

    setTimeout(() => { busy = false; }, 820);
  }

  /* Arrows */
  root.querySelector('.ddos6-prev').addEventListener('click', () => goTo(active - 1, -SA));
  root.querySelector('.ddos6-next').addEventListener('click', () => goTo(active + 1,  SA));

  /* ──────────────────────────────────────────
     DRAG — ORBIT PHYSICS
     Horizontal drag ↔ rotates all slots along
     the orbit ellipse in real-time (no transition).
     Release: if beyond threshold → navigate,
              otherwise → snap back.
  ────────────────────────────────────────── */
  let dragging   = false;
  let dragStartX = 0;
  let dragLastX  = 0;

  /* pixels needed to rotate one full side-angle */
  const PX_PER_DEG = 155 / SA;
  const CLAMP      = SA * 0.90;   /* max drag angle before navigation commits */

  stage.addEventListener('pointerdown', (e) => {
    if (busy) return;
    dragging   = true;
    dragStartX = dragLastX = e.clientX;
    stage.setPointerCapture(e.pointerId);
    slots.forEach((s) => { s.classList.add('instant'); s.classList.remove('snap'); });
  });

  stage.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    dragLastX = e.clientX;
    const dx = dragLastX - dragStartX;
    /* positive dx = drag right = prev product comes toward center */
    orbAngle = Math.max(-CLAMP, Math.min(CLAMP, dx / PX_PER_DEG));
    applyPos(orbAngle, true);
  });

  function endDrag() {
    if (!dragging) return;
    dragging = false;
    slots.forEach((s) => s.classList.remove('instant'));

    const dx = dragLastX - dragStartX;

    if (dx < -42 && !busy) {
      /* Drag left → next.
         Right slot was at SA + orbAngle, feed that as incoming so
         the transition continues from the drag end-point. */
      goTo(active + 1, SA + orbAngle);

    } else if (dx > 42 && !busy) {
      /* Drag right → prev */
      goTo(active - 1, -SA + orbAngle);

    } else {
      /* Aborted drag → spring back */
      orbAngle = 0;
      slots.forEach((s) => s.classList.add('snap'));
      applyPos(0, false);
      setTimeout(() => slots.forEach((s) => s.classList.remove('snap')), 520);
    }
  }

  stage.addEventListener('pointerup',     endDrag);
  stage.addEventListener('pointercancel', endDrag);

  /* ──────────────────────────────────────────
     ADD TO CART
  ────────────────────────────────────────── */
  atcEl.addEventListener('click', async () => {
    const p = PRODUCTS[active];
    if (!p.variantId) { location.href = p.url; return; }

    const origHTML   = atcEl.innerHTML;
    atcEl.textContent = 'Adding…';
    atcEl.disabled    = true;

    try {
      const r = await fetch('/cart/add.js', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ id: p.variantId, quantity: 1 }),
      });
      if (!r.ok) throw new Error();
      atcEl.textContent = '✓ Added!';
      setTimeout(() => { atcEl.innerHTML = origHTML; atcEl.disabled = false; }, 1300);
    } catch {
      location.href = p.url;
    }
  });

  /* ──────────────────────────────────────────
     INIT — load Shopify product data then render
  ────────────────────────────────────────── */
  async function init() {
    /* First pass: render with placeholders */
    assignImages();
    applyPos(0, true);
    void slots[1].offsetWidth;
    slots.forEach((s) => s.classList.remove('instant'));
    updateCard(false);

    /* Fetch real data from Shopify product API */
    await Promise.allSettled(
      PRODUCTS.map(async (p) => {
        try {
          const r    = await fetch(`/products/${p.handle}.js`);
          const data = await r.json();
          p.image     = data.featured_image;
          p.price     = data.price;
          p.variantId = data.variants?.[0]?.id ?? null;
        } catch { /* product may not exist in dev */ }
      })
    );

    /* Second pass: update images and price now that data is loaded */
    assignImages();
    const ap = PRODUCTS[active];
    priceEl.textContent = ap.price ? `LE ${Math.round(ap.price / 100)}` : '';
  }

  /* Recalculate positions on resize (orbRX is dynamic) */
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => applyPos(orbAngle, true), 80);
  });

  init();

})();
</script>
